{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kriarion.local/schemas/rig.schema.json",
  "title": "Rig Definition",
  "description": "Hierarquia de bones, limites articulares e slots do sistema paper-doll.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rig_id", "archetype", "version", "body_height_u", "bones", "slots"],
  "properties": {
    "rig_id": { "type": "string", "pattern": "^DB_RIG_[A-Z0-9_]+_RIG$|^DB_RIG_[A-Z0-9_]+$" },
    "archetype": {
      "enum": ["human_male_standard", "human_female_standard", "human_muscular", "human_child",
               "saiyan_male", "saiyan_female", "namekian", "majin", "android_humanoid",
               "frieza_race", "creature_small", "creature_quadruped", "creature_tail",
               "creature_winged", "boss_giant"]
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "body_height_u": { "type": "number", "minimum": 20, "maximum": 1200 },
    "coordinate_system": { "const": "top_left_y_down" },
    "bones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "parent", "x", "y"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_]+(\\.[0-9]{2})?$" },
          "parent": { "type": ["string", "null"] },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "length": { "type": "number", "minimum": 0 },
          "rot": { "type": "number", "minimum": -360, "maximum": 360 },
          "min": { "type": "number", "minimum": -360, "maximum": 360 },
          "max": { "type": "number", "minimum": -360, "maximum": 360 }
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layer", "anchor"],
        "properties": {
          "layer": { "type": "integer", "minimum": -10, "maximum": 30 },
          "anchor": { "type": "string" },
          "allowed_categories": { "type": "array", "items": { "type": "string" } },
          "optional": { "type": "boolean" }
        }
      }
    },
    "optional_bones": { "type": "array", "items": { "type": "string" } },
    "recolor_masks": { "type": "array", "items": { "type": "string" } },
    "compatible_bodies": { "type": "array", "items": { "type": "string" } },
    "approval": {
      "type": "object",
      "required": ["session", "report"],
      "properties": {
        "session": { "type": "string", "pattern": "^DB-SESSION-[0-9]{4}$" },
        "report": { "type": "string" }
      }
    }
  }
}
